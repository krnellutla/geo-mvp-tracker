# Environment variables the tracker needs on Vercel (Project Settings > Environment Variables).
# Never put real values in this file.

# Connects the save service to your Vercel Blob store. Created for you when you add a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Unlocks editing on the live site. Choose a long random string, for example: openssl rand -base64 18
EDIT_KEY=

# Lets the Google Form script add survey responses (and nothing else). A different random string from EDIT_KEY.
INGEST_KEY=
